{
  "name": "@sveltekit-i18n/extension-markdown",
  "version": "3.0.0-next.0",
  "description": "Renders Markdown in translated messages as Svelte components, for @sveltekit-i18n/base.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "svelte-package -i src -o dist -w",
    "typecheck": "tsc --noEmit -p tsconfig.json && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "pretest": "npm run build && npm run typecheck",
    "test": "vitest run",
    "bench": "node ../bench/run.mjs",
    "build": "svelte-package -i src -o dist",
    "prepublishOnly": "npm run build",
    "lint": "eslint --fix ."
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sveltekit-i18n/extensions.git",
    "directory": "extension-markdown"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "i18n",
    "l10n",
    "internationalization",
    "localization",
    "translation",
    "markdown",
    "rich-text"
  ],
  "author": "Jarda Svoboda",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sveltekit-i18n/lib/issues"
  },
  "homepage": "https://sveltekit-i18n.github.io",
  "funding": "https://github.com/sponsors/sveltekit-i18n",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "character-entities": "^2.0.2"
  },
  "peerDependencies": {
    "@sveltekit-i18n/base": "^3.0.0 || ^3.1.0-next.0",
    "svelte": ">=5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@sveltekit-i18n/base": "^3.3.0",
    "@sveltekit-i18n/parser-curly": "^3.2.1",
    "@sveltekit-i18n/parser-i18next": "^3.0.4",
    "@sveltekit-i18n/parser-icu": "^3.1.0",
    "@sveltekit-i18n/parser-mf2": "^3.1.0",
    "@types/node": "^26.2.0",
    "commonmark-spec": "^0.31.2",
    "eslint": "^10.8.1",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.14.5",
    "markdown-it": "^15.0.2",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "svelte": "./dist/index.js"
}
